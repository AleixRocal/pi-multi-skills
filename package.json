{
	"name": "@aleixrocal/pi-multi-skills",
	"version": "0.1.0",
	"description": "Chain several /skill: invocations in one pi message — N skills, one command.",
	"keywords": [
		"pi-package",
		"pi-coding-agent",
		"pi-extension",
		"agent-skills",
		"skills",
		"skill-chaining"
	],
	"type": "module",
	"license": "MIT",
	"author": "Aleix",
	"engines": {
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AleixRocal/pi-multi-skills.git"
	},
	"homepage": "https://github.com/AleixRocal/pi-multi-skills#readme",
	"bugs": {
		"url": "https://github.com/AleixRocal/pi-multi-skills/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"pi": {
		"extensions": ["./extensions/index.ts"]
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"check:pack": "node scripts/check-pack.mjs",
		"diagrams": "node scripts/diagrams.mjs",
		"release:notes": "node scripts/release-notes.mjs",
		"verify": "npm run typecheck && npm test && npm run check:pack"
	},
	"files": [
		"extensions/",
		"src/",
		"!**/*.test.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@types/node": "^26.6.5",
		"typebox": "*",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	}
}
